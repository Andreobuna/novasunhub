# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/novasunhub?schema=public"
# Neon-style setups: DATABASE_URL should be the pooled connection string
# (host has "-pooler" in it) — the app uses this at runtime. DATABASE_URL_DIRECT
# is the non-pooled connection string, used only by `prisma migrate`/`db push`.
# For Neon specifically, append &pgbouncer=true&connection_limit=1 to the
# pooled DATABASE_URL — without it Prisma's query engine tries to use
# prepared statements against PgBouncer's transaction-pooling mode, which
# doesn't support them, and you'll see connections silently getting closed.
DATABASE_URL_DIRECT="postgresql://user:password@localhost:5432/novasunhub?schema=public"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="nsh_session"

# --- App ---
NEXT_PUBLIC_SITE_NAME="NovaSunHub"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- External supplier / catalog API (server-side only, never exposed to client) ---
# Set once a provider is chosen. See src/lib/integrations/supplier.ts
API_KEY=
API_BASE_URL=

# --- Payments (Paystack) — server-side only ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# In your Paystack dashboard, under Settings > API Keys & Webhooks, set the
# webhook URL to:
#   {NEXT_PUBLIC_SITE_URL}/api/payments/paystack/webhook
# e.g. https://yourdomain.com/api/payments/paystack/webhook
# No separate webhook secret is needed — Paystack signs webhook payloads
# with PAYSTACK_SECRET_KEY itself (HMAC-SHA512, verified against the
# `x-paystack-signature` header in src/lib/integrations/paystack.ts).
